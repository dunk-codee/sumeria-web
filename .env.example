# Base de datos (Neon). Sin esta variable, en desarrollo se usa PGlite en .data/pglite
DATABASE_URL=

# Cloudinary (fotos de productos y eventos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Acceso al panel /admin
ADMIN_EMAIL=hola@sumeriasushi.com
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
